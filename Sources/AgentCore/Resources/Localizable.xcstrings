    "A secure connection to the server could not be made.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A secure connection to the server could not be made."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte keine sichere Verbindung zum Server hergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo establecer una conexión segura con el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'établir une connexion sécurisée avec le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile stabilire una connessione sicura con il server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーと安全な接続を確立できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버와 보안 연결을 설정할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível estabelecer uma conexão segura com o servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法与服务器建立安全连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
